APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Invoice PDF export (headless Chrome) + Horizon worker pool
CHROME_PATH=/usr/bin/chromium
NODE_MODULE_PATH=/opt/puppeteer/node_modules/
HORIZON_MAX_PROCESSES=8
HORIZON_DASHBOARD_EMAILS=

# Mail
# Local dev: Mailpit (started by docker compose) captures all mail — nothing is
#   sent for real. View messages (code, invite link) at http://localhost:8025.
#   No credentials needed.
# Production: point at Brevo SMTP instead —
#   MAIL_HOST=smtp-relay.brevo.com  MAIL_PORT=587
#   MAIL_USERNAME=<Brevo login>  MAIL_PASSWORD=<generated SMTP key, NOT account password>
#   Verify storetrack.io.vn (SPF + DKIM) in Brevo to avoid spam.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@storetrack.io.vn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# AI invoice extraction (Google Gemini). Swap providers via INVOICE_EXTRACTOR.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# INVOICE_EXTRACTOR=gemini

# Shared demo account (prod only). When both are set, the scheduler restores this
# password every 5 min so interviewers can't lock each other out. Leave blank to disable.
DEMO_ACCOUNT_EMAIL=
DEMO_ACCOUNT_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
